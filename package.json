{
    "name": "snoojote",
    "version": "1.0.0",
    "description": "Discord community operations bot with support tickets, moderation and transactional engagement rewards",
    "main": "src/index.ts",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "start": "bun src/index.ts",
        "dev": "bun --watch src/index.ts",
        "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.eslint.json",
        "build": "bun run typecheck",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown",
        "db:check": "bunx drizzle-kit check",
        "tickets:export-wait": "bun src/scripts/exportWaitObservations.ts",
        "tickets:backtest-wait": "bun src/scripts/backtestWaitEstimator.ts",
        "check": "bun run typecheck && bun run lint && bun run format:check && bun run db:check && bun test",
        "deploy": "bun src/scripts/deployCommands.ts",
        "test": "bun test",
        "audit": "bun audit --audit-level=moderate",
        "bench:runtime": "bun src/scripts/benchmarkRuntime.ts"
    },
    "keywords": [
        "typescript",
        "bun",
        "sqlite",
        "drizzle-orm",
        "discord-js",
        "queueing-theory",
        "state-machine",
        "concurrency"
    ],
    "author": "Carlos Mezquita",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@langchain/core": "^1.3.4",
        "@langchain/groq": "^1.3.1",
        "better-sqlite3": "^13.0.3",
        "canvas": "^3.2.3",
        "chalk": "^6.0.1",
        "discord.js": "^14.28.1",
        "dotenv": "^18.0.9",
        "drizzle-orm": "^0.45.4",
        "glob": "^14.0.2",
        "node-cron": "^4.6.0",
        "winston": "^3.19.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "1.4.4",
        "@types/node": "^26.6.6",
        "@types/ws": "^8.18.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "trustedDependencies": [
        "better-sqlite3",
        "canvas",
        "esbuild"
    ],
    "overrides": {
        "brace-expansion": "5.0.12",
        "esbuild": "0.28.1",
        "minimatch": "11.0.5",
        "undici": "6.29.1",
        "uuid": "11.1.1",
        "ws": "8.21.0"
    }
}
