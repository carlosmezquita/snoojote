{
    "name": "snoojote",
    "version": "1.0.0",
    "description": "Discord community operations bot with support tickets, moderation and transactional engagement rewards",
    "main": "src/index.ts",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "start": "bun src/index.ts",
        "dev": "bun --watch src/index.ts",
        "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
        "build": "bun run typecheck",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown",
        "db:check": "bunx drizzle-kit check",
        "tickets:backtest-wait": "bun src/scripts/backtestWaitEstimator.ts",
        "check": "bun run typecheck && bun run lint && bun run format:check && bun run db:check && bun test",
        "deploy": "bun src/scripts/deployCommands.ts",
        "test": "bun test",
        "audit": "bun audit --audit-level=high",
        "bench:runtime": "bun src/scripts/benchmarkRuntime.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@langchain/core": "^1.3.0",
        "@langchain/groq": "^1.3.1",
        "better-sqlite3": "^12.11.1",
        "canvas": "^3.2.3",
        "chalk": "^4.1.2",
        "discord.js": "^14.27.0",
        "dotenv": "^16.6.1",
        "drizzle-orm": "^0.45.4",
        "glob": "^13.0.6",
        "node-cron": "^3.0.3",
        "winston": "^3.19.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "1.4.4",
        "@types/node": "^22.20.5",
        "@types/node-cron": "^3.0.11",
        "@types/ws": "^8.18.2",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0"
    },
    "trustedDependencies": [
        "better-sqlite3",
        "canvas",
        "esbuild"
    ],
    "overrides": {
        "brace-expansion": "5.0.12",
        "esbuild": "0.28.1",
        "undici": "6.29.1",
        "uuid": "11.1.1",
        "ws": "8.21.0"
    }
}
